{
  "openapi": "3.0.0",
  "info": {
    "title": "Library API",
    "version": "1.0.0",
    "description": "Library API with CRUD operations for books and members. Authentication is handled using GitHub OAuth with Passport sessions."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    },
    {
      "url": "https://library-api-bnqp.onrender.com",
      "description": "Production Server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "GitHub OAuth authentication and user session management"
    },
    {
      "name": "Books",
      "description": "Book management endpoints"
    },
    {
      "name": "Members",
      "description": "Library member management endpoints"
    }
  ],
  "security": [
  {
    "cookieAuth": []
  }
],
  "paths": {

    "/auth/github": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login with GitHub OAuth",
        "description": "Redirects the user to GitHub for authentication."
      }
    },

    "/auth/github/callback": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "GitHub OAuth callback",
        "description": "Handles GitHub authentication response and creates a session."
      }
    },

    "/profile": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get logged-in user profile",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated user profile"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },

    "/logout": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Logout user",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully logged out"
          }
        }
      }
    },

    "/books": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get all books",
        "responses": {
          "200": {
            "description": "List of books"
          }
        }
      },

      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Create a new book",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Book"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Book created successfully"
          },
          "401": {
            "description": "Authentication required"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },

    "/books/{id}": {

      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get a book by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Book found"
          },
          "404": {
            "description": "Book not found"
          }
        }
      },

      "put": {
        "tags": [
          "Books"
        ],
        "summary": "Update a book",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Book"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Book updated successfully"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Cannot update another user's book"
          }
        }
      },

      "delete": {
        "tags": [
          "Books"
        ],
        "summary": "Delete a book",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Book deleted successfully"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Cannot delete another user's book"
          }
        }
      }
    },

    "/members": {

      "get": {
        "tags": [
          "Members"
        ],
        "summary": "Get all members",
        "responses": {
          "200": {
            "description": "List of members"
          }
        }
      },

      "post": {
        "tags": [
          "Members"
        ],
        "summary": "Create a member",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Member"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Member created successfully"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },

    "/members/{id}": {

      "get": {
        "tags": [
          "Members"
        ],
        "summary": "Get member by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Member found"
          },
          "404": {
            "description": "Member not found"
          }
        }
      },

      "put": {
        "tags": [
          "Members"
        ],
        "summary": "Update member",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Member"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Member updated"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      },

      "delete": {
        "tags": [
          "Members"
        ],
        "summary": "Delete member",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Member deleted"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    }
  },

  "components": {

    "securitySchemes": {

      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "library.sid",
        "description": "Passport session cookie created after GitHub OAuth login."
      }

    },

    "schemas": {

      "Book": {
        "type": "object",
        "required": [
          "title",
          "author",
          "genre",
          "year",
          "isbn",
          "publisher",
          "pages"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "The Great Gatsby"
          },
          "author": {
            "type": "string",
            "example": "F. Scott Fitzgerald"
          },
          "genre": {
            "type": "string",
            "example": "Classic"
          },
          "year": {
            "type": "number",
            "example": 1925
          },
          "isbn": {
            "type": "string",
            "example": "9780743273565"
          },
          "publisher": {
            "type": "string",
            "example": "Scribner"
          },
          "pages": {
            "type": "number",
            "example": 180
          },
          "available": {
            "type": "boolean",
            "example": true
          }
        }
      },

      "Member": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "email",
          "phone"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "example": "Smith"
          },
          "email": {
            "type": "string",
            "example": "john@email.com"
          },
          "phone": {
            "type": "string",
            "example": "555-1234"
          },
          "membershipDate": {
            "type": "string",
            "format": "date",
            "example": "2026-01-15"
          }
        }
      }

    }

  }
}